# EventSync 2.0 Environment Configuration

# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# PostgreSQL / Supabase Configuration
# For local PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/eventsync

# For Supabase (recommended):
# Get this from Supabase Project Settings > Database > Connection String (URI mode)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase API Configuration (optional for Row Level Security)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=10000

# Application Security
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Concurrency Control
BOOKING_LOCK_TIMEOUT_MS=5000
BOOKING_MAX_RETRIES=3
BOOKING_RETRY_DELAY_MS=100

# Idempotency
IDEMPOTENCY_KEY_EXPIRY_HOURS=24

# Testing
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/eventsync_test
